# Public browser configuration (safe to ship; never put credentials here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:2333
NEXT_PUBLIC_AGENT_API_URL=http://localhost:2333
NEXT_PUBLIC_AGENT_TIMEOUT=30000
NEXT_PUBLIC_AGENT_RETRY_ATTEMPTS=3
NEXT_PUBLIC_AGENT_HEALTH_CHECK_INTERVAL=30000
NEXT_PUBLIC_ENABLE_VOICE_COMMANDS=false
NEXT_PUBLIC_ENABLE_AGENT_TOOLS=true
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_AGENT_STREAMING=false
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_ENABLE_AGENT_LOGGING=false
NEXT_PUBLIC_LOG_AGENT_CONTENT=false
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=example-google-oauth-client-id
NEXT_PUBLIC_APP_NAME=ChenPilot
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Server/CI-only configuration (never add NEXT_PUBLIC_ to these names)
# These names are examples; do not put their values in browser/client environment files.
# GITHUB_TOKEN=<github-token-for-local-release-tooling>
# VERCEL_TOKEN=<vercel-deployment-token>
# VERCEL_ORG_ID=<vercel-org-id>
# VERCEL_PROJECT_ID=<vercel-project-id>
# LHCI_GITHUB_APP_TOKEN=<lighthouse-ci-token>
